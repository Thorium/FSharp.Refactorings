<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet convention for F# analyzers: FSAC/CLI load them from analyzers/dotnet/fs -->
    <IsPackable>true</IsPackable>
    <BuildOutputTargetFolder>analyzers/dotnet/fs</BuildOutputTargetFolder>
    <PackageId>FSharp.Refactor.Analyzers</PackageId>
    <Description>Functional refactoring suggestions (light bulb quick fixes) for F#, built on FSharp.Analyzers.SDK. Around 90 rules covering correctness, performance, idiom and redundancy; every one is Hint severity, so they never gate a build.</Description>
    <PackageReleaseNotes>0.3.0: new rules FR0090-FR0093 (project-wide tupled-to-curried and parameter reorder under --api-changes, static failwith messages gaining their arguments, reference-tuple fields). Fixes a case where a substituted method call lost needed parentheses, and three FR0081 false positives found by sweeping 3684 files of real F#.</PackageReleaseNotes>
    <Authors>Tuomas Hietanen</Authors>
    <PackageProjectUrl>https://github.com/Thorium/fsharp-refactor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thorium/fsharp-refactor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;analyzers;refactoring;codefix;ionide;fsautocomplete</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <!-- analyzers are build-time tools: nothing flows to the consumer's output -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- analyzer packages intentionally have no lib/ folder -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="RuleCatalog.fs" />
    <Compile Include="Text.fs" />
    <Compile Include="Visibility.fs" />
    <Compile Include="AstIndex.fs" />
    <Compile Include="Configuration.fs" />
    <Compile Include="MatchToIf.fs" />
    <Compile Include="OptionModule.fs" />
    <Compile Include="Composition.fs" />
    <Compile Include="ConversionMove.fs" />
    <Compile Include="CeStrip.fs" />
    <Compile Include="ActivePattern.fs" />
    <Compile Include="MutableRemoval.fs" />
    <Compile Include="TupleParams.fs" />
    <Compile Include="ResultModule.fs" />
    <Compile Include="Simplification.fs" />
    <Compile Include="StructActivePattern.fs" />
    <Compile Include="HintEngine.fs" />
    <Compile Include="RedundantParens.fs" />
    <Compile Include="MethodCallParens.fs" />
    <Compile Include="LambdaBuiltin.fs" />
    <Compile Include="PatternParens.fs" />
    <Compile Include="TypeSyntax.fs" />
    <Compile Include="TrailingSemicolon.fs" />
    <Compile Include="UnimplementedBranch.fs" />
    <Compile Include="DictTryGet.fs" />
    <Compile Include="RegexUsage.fs" />
    <Compile Include="StructDu.fs" />
    <Compile Include="DuFieldNames.fs" />
    <Compile Include="ParamOrder.fs" />
    <Compile Include="RaiseFailwith.fs" />
    <Compile Include="OptionOfObj.fs" />
    <Compile Include="AutoProperty.fs" />
    <Compile Include="ClosureCapture.fs" />
    <Compile Include="QueryInLoop.fs" />
    <Compile Include="TaskStateMachine.fs" />
    <Compile Include="AddRange.fs" />
    <Compile Include="StringConcat.fs" />
    <Compile Include="ObjectDesign.fs" />
    <Compile Include="OptionMatch.fs" />
    <Compile Include="LoopPerf.fs" />
    <Compile Include="IndexedLoop.fs" />
    <Compile Include="ListIndexing.fs" />
    <Compile Include="TypeTestChain.fs" />
    <Compile Include="RecursiveAppend.fs" />
    <Compile Include="CheckedArithmetic.fs" />
    <Compile Include="SubstringSpan.fs" />
    <Compile Include="TypeChecks.fs" />
    <Compile Include="CharOverload.fs" />
    <Compile Include="CaseInsensitive.fs" />
    <Compile Include="RedundantGuard.fs" />
    <Compile Include="VectorizedLinq.fs" />
    <Compile Include="SprintfInterpolation.fs" />
    <Compile Include="TypedHoles.fs" />
    <Compile Include="Reraise.fs" />
    <Compile Include="NaNComparison.fs" />
    <Compile Include="WeakLock.fs" />
    <Compile Include="FormatArgs.fs" />
    <Compile Include="SyncOverAsync.fs" />
    <Compile Include="Accumulation.fs" />
    <Compile Include="CountIsEmpty.fs" />
    <Compile Include="HexString.fs" />
    <Compile Include="SwallowedException.fs" />
    <Compile Include="XmlDocParams.fs" />
    <Compile Include="RecursiveSeq.fs" />
    <Compile Include="StructOption.fs" />
    <Compile Include="AttributeMerge.fs" />
    <Compile Include="ArgNames.fs" />
    <Compile Include="ExceptionRules.fs" />
    <Compile Include="SecurityRules.fs" />
    <Compile Include="MiscRules.fs" />
    <Compile Include="StructHints.fs" />
    <Compile Include="LoopInvariant.fs" />
    <Compile Include="ExpandWildcard.fs" />
    <Compile Include="MatchBangRule.fs" />
    <Compile Include="NestedRecordUpdate.fs" />
    <Compile Include="UseBinding.fs" />
    <Compile Include="MapIgnore.fs" />
    <Compile Include="SingleAwaitable.fs" />
    <Compile Include="ImplementMissing.fs" />
    <Compile Include="TabIndentation.fs" />
    <Compile Include="PathSeparator.fs" />
    <Compile Include="RedundantSyntax.fs" />
    <Compile Include="PatternCleanups.fs" />
    <Compile Include="RedundantNew.fs" />
    <Compile Include="AsyncIgnore.fs" />
    <Compile Include="ObjectRules.fs" />
    <Compile Include="InterpToString.fs" />
    <Compile Include="FailwithContext.fs" />
    <Compile Include="Analyzers.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.37.2" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" />
  </ItemGroup>

</Project>
