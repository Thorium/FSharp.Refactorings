<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMinor</RollForward>
    <!-- ships as a dotnet tool: dotnet tool install fsharp-refactorings-apply -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsharp-refactor</ToolCommandName>
    <PackageId>fsharp-refactorings-apply</PackageId>
    <Description>Applies FSharp.Refactorings quick fixes to F# projects from the command line.</Description>
    <Authors>Tuomas Hietanen</Authors>
    <PackageProjectUrl>https://github.com/Thorium/FSharp.Refactorings</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thorium/FSharp.Refactorings</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;analyzers;refactoring;codefix;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.201" />
    <ProjectReference Include="..\FSharp.Refactorings.Analyzers\FSharp.Refactorings.Analyzers.fsproj" />
  </ItemGroup>

</Project>
