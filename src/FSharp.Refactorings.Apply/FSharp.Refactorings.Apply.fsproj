<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMinor</RollForward>
    <!-- ships as a dotnet tool: dotnet tool install fsharp-refactorings-apply -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsharp-refactor</ToolCommandName>
    <PackageId>fsharp-refactorings-apply</PackageId>
    <Description>Applies FSharp.Refactorings quick fixes to F# code from the command line. Point it at a project, a script, a solution, a directory or a glob; --dry-run reports without editing.</Description>
    <PackageReleaseNotes>0.3.0: takes a bare path and infers the kind — .fsproj, a single .fs, .fsx, .sln/.slnx, a directory or a glob. Scripts skip MSBuild entirely. Multi-targeted and strong-named projects now work. Files are typechecked in parallel (--jobs, default 4). New rules FR0090-FR0093; several false positives fixed.</PackageReleaseNotes>
    <Authors>Tuomas Hietanen</Authors>
    <PackageProjectUrl>https://github.com/Thorium/FSharp.Refactorings</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Thorium/FSharp.Refactorings</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fsharp;analyzers;refactoring;codefix;dotnet-tool</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.201" />
    <ProjectReference Include="..\FSharp.Refactorings.Analyzers\FSharp.Refactorings.Analyzers.fsproj" />
  </ItemGroup>

</Project>
